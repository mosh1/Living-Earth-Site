---
import Layout from '../layouts/Layout.astro';
// The kit's text, shared with the ZIP's README (livingearth-design/website/tools/press-kit.py)
import { Content } from '../press.md';
---

<Layout title="Living Earth press kit" description="Facts, images, videos and contacts for writing about Living Earth.">
  <article class="mx-auto w-full max-w-3xl px-6 pb-24 pt-32 text-white/70 [&_a]:underline [&_a:hover]:text-white [&_h1]:text-4xl [&_h1]:font-bold [&_h1]:tracking-tight [&_h1]:text-white [&_h2]:mt-14 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-white [&_p]:mt-4 [&_strong]:text-white [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_table]:mt-6 [&_table]:w-full [&_td]:border-t [&_td]:border-white/10 [&_td]:py-2 [&_td]:pr-4 [&_td]:align-top [&_td:first-child]:whitespace-nowrap [&_td:first-child]:text-white [&_thead]:hidden [&_blockquote]:mt-6 [&_blockquote]:border-l-2 [&_blockquote]:border-white/20 [&_blockquote]:pl-4 [&_blockquote_p]:mt-0 [&_blockquote_p+p]:mt-1 [&_blockquote_p+p]:text-sm [&_blockquote_p+p]:text-white/50 [&_code]:text-white [&_img]:mt-8 [&_img]:h-auto [&_img]:w-full [&_img]:rounded-2xl">
    <Content />
  </article>
</Layout>
