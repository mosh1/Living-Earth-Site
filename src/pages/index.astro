---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { IOS_URL, lookup, worldRating } from '../appstore';
import { reviews } from '../reviews';
// IANA time zone -> [lat, lon] of its city, from tzdata's zone.tab
import zones from '../zones.js?raw';
import badge from '../assets/badge-app-store.svg';
import qr from '../assets/home/qr-app-store.svg';
import ipadClouds from '../assets/home/ipad-02-clouds.png';
import duoStorms from '../assets/home/duo-closed-03-storms.png';
import duoCities from '../assets/home/duo-open-06-cities.png';
import zoomLabels from '../assets/home/zoom-labels.jpg';
import iphoneEclipse from '../assets/home/iphone-07-eclipse.png';
import iphoneForecast from '../assets/home/iphone-04-forecast.png';
import ipadForecast from '../assets/home/ipad-04-forecast.png';
import duoForecast from '../assets/home/duo-closed-04-forecast.png';
import iphoneClouds from '../assets/home/iphone-02-clouds.png';
import film from '../assets/home/dawn-over-europe.mp4';
import filmPoster from '../assets/home/dawn-over-europe.jpg';

// The device images are composites of the app's own captures in Apple's bezels, each as many
// inches wide as the device at 120 px per inch (livingearth-design/website/tools/build-v2.py).
// public/hero/ holds the hero's regions, picked in the browser, so they are WebP already
// (cwebp -q 80 -m 6); the rest go through Astro's image pipeline.

const [ios, world] = await Promise.all([lookup(379869627), worldRating(379869627)]);
// The rating across every storefront; if that lookup fails, the US store's, worded as such.
// Fallbacks are the US App Store's values on 9 Oct 2026, used only if both lookups fail.
const rating = (world?.average ?? ios?.averageUserRating ?? 4.77).toFixed(1);
const ratingCount = world?.count ?? ios?.userRatingCount ?? 15534;
const where = world ? 'on the App Store worldwide' : 'on the App Store';
const price = ios?.formattedPrice ?? '$5.99';
const thousands = Math.floor(ratingCount / 1000);
// The count as the App Store abbreviates it (15,534 is "16K"); spelled out, the reviews line
// rounds down so it never overstates.
const ratingsShort = new Intl.NumberFormat('en-US', { notation: 'compact' }).format(ratingCount);

const press = [
  { quote: 'In a sea of more complicated and ambitious apps, Living Earth is beautifully simple.', source: 'The New York Times' },
  { quote: 'Living Earth is proof that a world clock and weather app can be beautiful.', source: 'Apple, App Store' },
  { quote: 'A stunning app that shows the Earth in real time, based on global weather reports.', source: 'WIRED Insider' },
  { quote: 'Living Earth is visually impressive and just fun.', source: 'MacStories' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Living Earth',
  operatingSystem: 'iOS 18.5 or later',
  applicationCategory: 'WeatherApplication',
  url: 'https://apps.apple.com/app/id379869627',
  offers: { '@type': 'Offer', price: ios?.price ?? 5.99, priceCurrency: ios?.currency ?? 'USD' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: rating, ratingCount },
  author: { '@type': 'Organization', name: 'Radiantlabs, LLC' },
};
---

<Layout
  title="Living Earth: our planet, live"
  description="See our planet as it looks from space right now, with live clouds, storms and the weather in the places you care about. For iPhone, iPad and iPhone Duo."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline set:html={zones} />
    <script is:inline>
      // Where and when the visitor is: tzdata places each time zone's city, so no location prompt.
      // The page never names that city (a zone covers far more than the city it is named after);
      // it only places the Sun, and picks the region the hero shows. Zones tzdata does not list
      // (UTC, old aliases) fall back to the clock for the phase and the Americas west for the hero.
      window.LE = {
        here: window.LE_ZONES[Intl.DateTimeFormat().resolvedOptions().timeZone || ''],

        // The Sun's height above the horizon at a place, in degrees, from the low-precision
        // solar position in the Astronomical Almanac (good to ~0.01°).
        sunElevation(lat, lon, date) {
          const rad = Math.PI / 180, d = date / 86400000 + 2440587.5 - 2451545.0;
          const g = (357.529 + 0.98560028 * d) * rad;
          const L = (280.459 + 0.98564736 * d + 1.915 * Math.sin(g) + 0.020 * Math.sin(2 * g)) * rad;
          const e = (23.439 - 0.00000036 * d) * rad;
          const ra = Math.atan2(Math.cos(e) * Math.sin(L), Math.cos(L)) / rad;
          const dec = Math.asin(Math.sin(e) * Math.sin(L)) / rad;
          const gmst = (18.697374558 + 24.06570982441908 * d) % 24;
          const sunLon = ((ra - gmst * 15) % 360 + 540) % 360 - 180;
          return Math.asin(Math.sin(lat * rad) * Math.sin(dec * rad) +
            Math.cos(lat * rad) * Math.cos(dec * rad) * Math.cos((lon - sunLon) * rad)) / rad;
        },

        phaseAt(d) {
          if (!LE.here) { const h = d.getHours() + d.getMinutes() / 60; return h < 6 || h >= 20 ? 'night' : h < 8 ? 'dawn' : h < 18 ? 'day' : 'dusk'; }
          const sun = LE.sunElevation(LE.here[0], LE.here[1], d);
          if (sun >= 6) return 'day';
          if (sun < -6) return 'night';
          return LE.sunElevation(LE.here[0], LE.here[1], new Date(+d + 600000)) > sun ? 'dawn' : 'dusk';
        },

        // The hero's regions (StoreShotsUITests.testSiteHero, testSiteZoom) and the city each shows.
        regions: { 'americas-west': 'San Francisco', 'americas-central': 'Chicago', 'americas-east': 'New York City',
          'south-america': 'São Paulo', 'europe': 'London', 'south-asia': 'Mumbai', 'east-asia': 'Tokyo',
          'southeast-asia': 'Singapore', 'oceania': 'Sydney' },

        // By the time zone city's place. The US splits by its zones: Pacific and Arizona west of
        // -110, Mountain and Central to -87 (Denver, Chicago, Mexico City), Eastern east of that
        // (Detroit, Indianapolis). Africa falls to Europe and Russia to Europe, by their hours.
        regionAt: ([lat, lon]) =>
            lon < -150 && lat < 0 ? 'oceania'                    // the South Pacific past the date line
          : lon < -110 ? 'americas-west'
          : lon < -30 ? (lat < 15 ? 'south-america' : lon < -87 ? 'americas-central' : 'americas-east')
          : lon < 45 ? 'europe'
          : lon < 92 ? 'south-asia'                              // the Gulf to Bangladesh
          : lat < -10 ? 'oceania'
          : lat < 20 ? 'southeast-asia' : 'east-asia',

        paintHero(phase) {
          const names = { iphone: 'iPhone', ipad: 'iPad' };
          const city = LE.regions[LE.region], when = phase === 'day' ? 'midday' : phase;
          document.querySelectorAll('[data-device]').forEach(img => {
            const device = img.dataset.device, zoom = img.dataset.view === 'zoom';
            img.src = `/hero/${LE.region}-${phase}${zoom ? '-zoom' : ''}-${device}.webp`;
            img.alt = zoom ? `Living Earth on ${names[device]}: ${city}'s clouds up close at ${when}`
              : `Living Earth on ${names[device]}: the Earth, ${city} at ${when}`;
          });
        },
      };
      // ?region= shows another region's hero, for review
      const asked = new URLSearchParams(location.search).get('region');
      LE.region = asked in LE.regions ? asked : LE.here ? LE.regionAt(LE.here) : 'americas-west';
      document.documentElement.dataset.sky = LE.phaseAt(new Date());
    </script>
  </Fragment>

  <main>
    <section class="sky-panel">
      <!-- The visitor's region in their own light, the whole Earth on iPhone and up close on iPad
           at the same instant: set as the images are parsed, so only the visitor's set loads;
           without script, the Americas west at night, matching the headline and sky the page starts with. -->
      <div class="wrap hero-devices"><div class="devices-row">
        <img class="iphone" style="--w: 3.19" width="383" height="783" data-device="iphone" alt="" />
        <img class="ipad" style="--w: 11.37" width="1364" height="1045" data-device="ipad" data-view="zoom" alt="" />
        <script is:inline>LE.paintHero(LE.phaseAt(new Date()))</script>
        <noscript>
          <img class="iphone" style="--w: 3.19" width="383" height="783" src="/hero/americas-west-night-iphone.webp" alt="Living Earth on iPhone: the Earth, San Francisco at night" />
          <img class="ipad" style="--w: 11.37" width="1364" height="1045" src="/hero/americas-west-night-zoom-ipad.webp" alt="Living Earth on iPad: San Francisco's clouds up close at night" />
        </noscript>
      </div></div>
      <div class="wrap">
        <h1>It’s <em data-word>night</em> where you are.</h1>
        <p class="sub">See our planet as it looks from space right now, with live clouds, storms and the weather in the places you care about.</p>
        <div class="laurels"><div class="laurel"><strong>{rating} ★</strong><span>{ratingsShort} {world ? 'App Store ratings worldwide' : 'ratings on the App Store'}</span></div></div>
        <div class="badges">
          <a href={IOS_URL}><Image src={badge} alt="Download on the App Store" loading="eager" /></a>
          <!-- Whoever scans may hold an iPad or another phone; "on the App Store" is Apple's wording. -->
          <a class="qr" href={IOS_URL}><Image src={qr} alt="QR code for Living Earth on the App Store" loading="eager" /><span>Scan to get it<br />on the App Store</span></a>
        </div>
      </div>
    </section>

    <section class="feature wrap">
      <div class="media"><Image src={ipadClouds} alt="Clouds over California on iPad" /></div>
      <div>
        <p class="eyebrow">Clouds</p>
        <h2>Real clouds, every hour.</h2>
        <p class="lede">Satellite images cover the globe, so the clouds you see are the ones overhead. Check back throughout the day to watch fronts and storms roll in.</p>
      </div>
    </section>

    <section class="band wrap">
      <p class="eyebrow">Day and night</p>
      <h2>See the sunrise sweep the planet.</h2>
      <p class="lede">Day turns to night across the globe, and city lights come on as darkness falls. Every sunrise and sunset, as it happens.</p>
      <div class="film"><video src={film} poster={filmPoster.src} autoplay muted loop playsinline aria-label="Dawn sweeping across Europe, rendered by Living Earth"></video></div>
    </section>

    <section class="feature flip wrap">
      <div class="media"><Image src={duoStorms} alt="Super Typhoon Choi-wan on the cover screen of iPhone Duo, with its strength, speed and winds" /></div>
      <div>
        <p class="eyebrow">Storms</p>
        <h2>Keep an eye on every storm.</h2>
        <p class="lede">See hurricanes and typhoons anywhere in the world, with each storm’s category, speed and heading. Living Earth tells you when a new one forms or changes strength.</p>
      </div>
    </section>

    <section class="feature wrap">
      <div class="media"><Image src={duoCities} alt="The time and weather in six cities beside the globe, on iPhone Duo" /></div>
      <div>
        <p class="eyebrow">Your cities</p>
        <h2>A world clock with a view.</h2>
        <p class="lede">Add the cities in your life: home, family far away, your next trip. See the time and weather in each at a glance, and tap one for the hourly and 10-day forecast.</p>
      </div>
    </section>

    <section class="feature flip wrap">
      <div class="media"><Image class="shot" src={zoomLabels} width={1200} alt="The Nile and the Red Sea up close, with country and city names" /></div>
      <div>
        <p class="eyebrow">Up close</p>
        <h2>From orbit to coastline.</h2>
        <p class="lede">Pinch in for a closer look at clouds, mountains and rivers. Borders and place names appear as you zoom, and Search takes you anywhere on Earth.</p>
      </div>
    </section>

    <section class="feature wrap">
      <div class="media"><Image src={iphoneEclipse} alt="A total solar eclipse in progress, the Moon's shadow over Arabia, on iPhone" /></div>
      <div>
        <p class="eyebrow">The sky</p>
        <h2>Never miss an eclipse.</h2>
        <p class="lede">Watch the Moon’s shadow race across the Earth, or the Moon turn deep red, and get an alert when a total eclipse begins. The Moon shows its current phase, set against the stars and the Milky Way.</p>
      </div>
    </section>

    <section class="every-section wrap">
      <p class="eyebrow">iPhone, iPad and iPhone Duo</p>
      <h2>On every screen.</h2>
      <p class="lede">Designed for each device, with your cities in sync over iCloud.</p>
      <div class="every"><div class="devices-row">
        <Image style="--w: 3.19" src={iphoneForecast} alt="The forecast for New York on iPhone" />
        <Image class="ipad" style="--w: 11.37" src={ipadForecast} alt="The forecast for New York beside the globe on iPad" />
        <Image style="--w: 3.43" src={duoForecast} alt="The forecast for New York on iPhone Duo, closed" />
      </div></div>
    </section>

    <section class="reviews wrap">
      <header>
        <h2>A favorite, year after year.</h2>
        <p class="lede">{rating} stars from more than {(thousands * 1000).toLocaleString('en-US')} ratings {where}.</p>
      </header>
      <div class="press">
        {press.map(p => <blockquote>“{p.quote}”<cite>{p.source}</cite></blockquote>)}
      </div>
      <!-- A strip that drifts left, two cards to a column, until the visitor scrolls it, or
           pauses it with the button. The reviews appear twice so the drift loops without a jump;
           the second set is hidden from VoiceOver. -->
      <div class="voices" data-voices role="region" aria-label="App Store reviews" tabindex="0">
        <div class="voices-track">
          {[...reviews, ...reviews].map((r, i) => (
            <figure aria-hidden={i >= reviews.length ? 'true' : undefined} data-loop-start={i === reviews.length ? '' : undefined}>
              <blockquote>“{r.quote}”</blockquote>
              <figcaption><span class="stars" aria-label="5 stars">★★★★★</span>App Store review, {r.year}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <button class="voices-toggle glass" data-voices-toggle hidden aria-label="Pause the reviews">
        <svg class="pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="1" /><rect x="9.5" y="2.5" width="3" height="11" rx="1" /></svg>
        <svg class="play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.9v10.2a.9.9 0 0 0 1.37.77l8.3-5.1a.9.9 0 0 0 0-1.54l-8.3-5.1A.9.9 0 0 0 4.5 2.9Z" /></svg>
      </button>
    </section>

    <section class="wrap">
      <div class="buy">
        <div class="copy">
          <h2>One purchase for iPhone and iPad.</h2>
          <p>{price}, once, with no subscription. Private by design: no accounts, no ads, no tracking, and we never sell your data.</p>
          <div class="badges">
            <a href={IOS_URL}><Image src={badge} alt="Download on the App Store" /></a>
            <a class="qr" href={IOS_URL}><Image src={qr} alt="QR code for Living Earth on the App Store" /><span>Scan to get it<br />on the App Store</span></a>
          </div>
        </div>
        <Image class="phone" src={iphoneClouds} alt="" />
      </div>
    </section>
  </main>

  <div class="preview glass dim" role="group" aria-label="Preview the sky (review control)">
    <span>Preview</span>
    <button data-mode="now" aria-pressed="true">Now</button>
    <button data-mode="night" aria-pressed="false">Night</button>
    <button data-mode="dawn" aria-pressed="false">Dawn</button>
    <button data-mode="day" aria-pressed="false">Day</button>
    <button data-mode="dusk" aria-pressed="false">Dusk</button>
  </div>

  <script is:inline>
    const words = { night: 'night', dawn: 'dawn', day: 'daytime', dusk: 'dusk' };
    let mode = 'now';

    function paint() {
      const phase = mode === 'now' ? LE.phaseAt(new Date()) : mode;
      document.documentElement.dataset.sky = phase;
      document.querySelector('[data-word]').textContent = words[phase];
      if (!document.querySelector('[data-device]').src.includes(`-${phase}-`)) LE.paintHero(phase);
    }
    // ?preview shows a control to see every sky without waiting for it
    if (new URLSearchParams(location.search).has('preview')) document.body.classList.add('previewing');
    document.querySelectorAll('[data-mode]').forEach(b => b.addEventListener('click', () => {
      mode = b.dataset.mode;
      document.querySelectorAll('[data-mode]').forEach(x => x.setAttribute('aria-pressed', x === b));
      paint();
    }));
    // Now, and again at the top of every minute
    paint();
    setTimeout(() => { paint(); setInterval(paint, 60000); }, 60000 - Date.now() % 60000);

    // The reviews strip drifts left at a reading pace while it is on screen, pausing under the
    // pointer. Once the visitor scrolls it, clicks or focuses it, or presses pause, the drift
    // stops where it is and the strip is a plain scroller; play drifts on from there.
    (() => {
      const strip = document.querySelector('[data-voices]'), track = strip.firstElementChild;
      const toggle = document.querySelector('[data-voices-toggle]'), SPEED = 25;  // px a second
      // One set of reviews: from the first card to the first card of the copy
      const loop = () => strip.querySelector('[data-loop-start]').offsetLeft - track.firstElementChild.offsetLeft;
      const measure = () => {
        strip.style.setProperty('--drift', loop() + 'px');
        strip.style.setProperty('--drift-time', loop() / SPEED + 's');
      };
      const set = drifting => {
        strip.classList.toggle('drifting', drifting);
        toggle.classList.toggle('stopped', !drifting);
        toggle.setAttribute('aria-label', drifting ? 'Pause the reviews' : 'Play the reviews');
      };
      const stop = () => {
        if (!strip.classList.contains('drifting')) return;
        const x = -new DOMMatrix(getComputedStyle(track).transform).m41;
        set(false);
        strip.scrollLeft += x;  // the drift's offset becomes the scroll position, so nothing moves
      };
      const play = () => {
        const x = strip.scrollLeft % loop();
        strip.scrollLeft = 0;
        track.style.animationDelay = -x / SPEED + 's';  // start the drift where the strip stands
        set(true);
      };
      measure();
      addEventListener('resize', measure);
      new IntersectionObserver(([e]) => strip.classList.toggle('offscreen', !e.isIntersecting)).observe(strip);
      // A finger landing on the strip to scroll the page past it is not taking over; only a
      // sideways swipe is. A mouse press, a tap or keyboard focus is.
      let start;
      strip.addEventListener('pointerdown', e => { if (e.pointerType !== 'touch') stop(); });
      strip.addEventListener('touchstart', e => { start = [e.touches[0].clientX, e.touches[0].clientY]; }, { passive: true });
      strip.addEventListener('touchmove', e => {
        const dx = Math.abs(e.touches[0].clientX - start[0]), dy = Math.abs(e.touches[0].clientY - start[1]);
        if (dx > 8 && dx > dy) stop();
      }, { passive: true });
      strip.addEventListener('focusin', stop);
      strip.addEventListener('wheel', e => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) stop(); }, { passive: true });
      toggle.addEventListener('click', () => strip.classList.contains('drifting') ? stop() : play());
      toggle.hidden = false;
      set(true);
    })();
  </script>
</Layout>

<style is:global>
  /* The page takes the colour of the visitor's sky, the way Tide Guide's palette "changes with the sky".
     Registered so the gradients ease from one phase to the next instead of jumping. */
  @property --sky-top { syntax: '<color>'; inherits: true; initial-value: #02030a; }
  @property --sky-mid { syntax: '<color>'; inherits: true; initial-value: #07112a; }
  @property --sky-low { syntax: '<color>'; inherits: true; initial-value: #0e1f44; }
  @property --deep { syntax: '<color>'; inherits: true; initial-value: #03060f; }
  @property --word-a { syntax: '<color>'; inherits: true; initial-value: #64D2FF; }
  @property --word-b { syntax: '<color>'; inherits: true; initial-value: #5E5CE6; }

  :root { transition: --sky-top 1.4s var(--ease), --sky-mid 1.4s var(--ease), --sky-low 1.4s var(--ease), --deep 1.4s var(--ease), --word-a 1.4s, --word-b 1.4s; }
  /* The text sits in the mid band, so each phase keeps that band dark enough for white text;
     the horizon colour comes in only below the buttons. */
  :root[data-sky="night"] { --sky-top: #02030a; --sky-mid: #091634; --sky-low: #1d3a6e; --deep: #03060f; --word-a: #64D2FF; --word-b: #8e8cff; }
  :root[data-sky="dawn"]  { --sky-top: #0b1233; --sky-mid: #2c2c63; --sky-low: #d9887a; --deep: #0b0f26; --word-a: #ffc3a0; --word-b: #ff8fb1; }
  :root[data-sky="day"]   { --sky-top: #021a48; --sky-mid: #0e5cb8; --sky-low: #9fd2f6; --deep: #04193a; --word-a: #fff1a8; --word-b: #FFD60A; }
  :root[data-sky="dusk"]  { --sky-top: #100b2e; --sky-mid: #3a2160; --sky-low: #f0804a; --deep: #0f0a24; --word-a: #FF9F0A; --word-b: #ff5f8a; }

  body { background: var(--deep); }
  .wrap { width: min(1120px, 100% - 2 * clamp(16px, 4vw, 40px)); margin-inline: auto; }
  h1, h2, .sub, .lede { text-wrap: balance; }
  p { text-wrap: pretty; }

  /* Devices are Apple's bezels at their true relative size: each image is as many inches wide
     as the device, and --in is the page's pixels per inch. No shadows, no overlap, nothing
     cropped, as Apple's marketing guidelines ask. */
  .devices-row { display: flex; align-items: flex-end; justify-content: center; flex-wrap: wrap; gap: calc(var(--in) * .7); }
  .devices-row img { width: calc(var(--in) * var(--w)); height: auto; }
  .devices-row img:not([src]) { display: none; }
  /* Without script, the fallback's images stand in the row like the devices they replace.
     Only then: with script on, noscript holds its markup as raw text, which Chrome hides only by
     giving noscript no box, and display: contents would print that text beside the hero. */
  @media (scripting: none) { .devices-row noscript { display: contents; } }

  /* Hero: a panel of sky with rounded lower corners. The horizon glow rises a fixed 220px from
     the panel's bottom edge, whatever its height, so it starts just under the buttons and the
     text above it stays on the dark sky. */
  .sky-panel { padding: 110px 0 96px; border-radius: 0 0 44px 44px; text-align: center;
    background: linear-gradient(0deg, var(--sky-low), var(--sky-mid) 220px, var(--sky-top)); }
  /* Two devices sized by their container, never the window, so they never wrap */
  .hero-devices { container-type: inline-size; }
  .hero-devices .devices-row { --in: min(64px, 100cqw / 15.4); flex-wrap: nowrap; }
  .sky-panel h1 { margin-top: 56px; font-size: clamp(40px, 6vw, 80px); font-weight: 700; line-height: 1.02; letter-spacing: -0.04em; }
  .sky-panel h1 em { font-style: normal; background: linear-gradient(90deg, var(--word-a), var(--word-b)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sky-panel .sub { max-width: 44ch; margin: 18px auto 0; font-size: 21px; line-height: 1.4; color: rgba(255,255,255,.86); }
  .sky-panel .laurels { margin-top: 28px; }
  /* The two small lines sit low, where the day sky's pale horizon begins, so they take full white */
  .sky-panel .laurel span, .sky-panel .qr span { color: #fff; }
  .sky-panel .badges { justify-content: center; margin-top: 22px; }

  /* One reason per section, as Binge lays them out: a label, a short headline, two sentences
     and one picture, alternating sides. */
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--word-a); }
  .feature h2, .band h2, .every-section h2, .reviews h2 { margin-top: 10px; font-size: clamp(34px, 4.4vw, 54px); font-weight: 700; line-height: 1.04; letter-spacing: -0.035em; }
  .lede { margin-top: 16px; font-size: 19px; line-height: 1.5; color: var(--secondary); max-width: 40ch; }
  .feature { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; padding-top: clamp(90px, 13vh, 150px); }
  .feature.flip .media { order: 2; }
  .feature .media { display: grid; place-items: center; }
  /* Full column width, so the width and height attributes' ratio sizes the box before a lazy
     image arrives (with an auto width an unloaded image has no size and collapses to 0 x 0);
