---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-white/10">
  {items.map(({ q, a }) => (
    <details class="group py-5">
      <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
        <span class="flex items-center justify-between gap-4">{q}<span class="text-white/40 transition group-open:rotate-45" aria-hidden="true">+</span></span>
      </summary>
      <p class="mt-3 whitespace-pre-line text-white/65">{a}</p>
    </details>
  ))}
</div>
